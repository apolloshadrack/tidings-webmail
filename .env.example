# Tidings configuration. Every value can also be passed as TIDINGS_<NAME>_FILE=/path/to/secret.
# Generate a secret with: openssl rand -base64 48
TIDINGS_SECRET=
TIDINGS_PUBLIC_URL=https://mail.example.com/
TIDINGS_IMAP_URL=imaps://mail.example.com:993
TIDINGS_SMTP_URL=smtp://mail.example.com:587
# Optional: filters & vacation via ManageSieve
TIDINGS_SIEVE_URL=sieve://mail.example.com:4190
# Optional: let users sign in with just their local part
TIDINGS_DEFAULT_DOMAIN=example.com
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-* headers are trusted
TIDINGS_TRUSTED_PROXIES=
