# Dovecot 2.4 config for the Tidings local dev stack. Rendered by start.sh into run/dovecot.conf.
# Unprivileged: runs as the current user, loopback only, plaintext auth on loopback.
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0

base_dir = __RUN__/base
state_dir = __RUN__/state
log_path = __RUN__/dovecot.log
info_log_path = __RUN__/dovecot.log
instance_name = tidings-dev

listen = 127.0.0.1
protocols = imap lmtp sieve

default_internal_user = __USER__
default_internal_group = __GROUP__
default_login_user = __USER__
first_valid_uid = 1
# macOS rejects RLIMIT_DATA / tight process limits for unprivileged users
default_vsz_limit = 9223372036854775807
default_process_limit = 10
default_client_limit = 500
first_valid_gid = 0

ssl = no
auth_allow_cleartext = yes
auth_mechanisms = plain login
login_trusted_networks = 127.0.0.0/8 ::1/128

passdb passwd-file {
  passwd_file_path = __DIR__/users.example
}
userdb passwd-file {
  passwd_file_path = __DIR__/users.example
  fields {
    uid = __USER__
    gid = __GROUP__
    home = __RUN__/mail/%{user | domain}/%{user | username}
  }
}

mail_driver = maildir
mail_path = ~/Maildir
mail_uid = __USER__
mail_gid = __GROUP__

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
}

mail_plugins {
  quota = yes
}
quota "User quota" {
  storage_size = 1G
}
protocol imap {
  mail_plugins {
    imap_quota = yes
  }
}

protocol lmtp {
  mail_plugins {
    sieve = yes
  }
}

sieve_script personal {
  driver = file
  path = ~/sieve
  active_path = ~/.dovecot.sieve
}
submission_host = 127.0.0.1:2525

service imap-login {
  chroot =
  inet_listener imap {
    port = 1143
  }
  inet_listener imaps {
    port = 0
  }
}
service lmtp {
  inet_listener lmtp {
    port = 12024
  }
}
service managesieve-login {
  chroot =
  inet_listener sieve {
    port = 14190
  }
}
service pop3-login {
  chroot =
}
service submission-login {
  chroot =
}
service imap-urlauth-login {
  chroot =
}
service anvil {
  chroot =
}
